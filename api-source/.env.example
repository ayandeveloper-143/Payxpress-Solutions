PORT=8846

# GST settings
GST_TYPE=included   # or "extra"
GST_PERCENT=18

# Gateway fee settings
GATEWAY_FEE_PERCENT=2
CLIENT_ORIGIN=https://payxpress-solutions.com,http://localhost:8080,http://localhost:5173

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=payxpress

# Payment gateway
PAYMENT_GATEWAY_ENABLED=true

# Payment gateway selector: "cashfree" or "razorpay"
PAYMENT_GATEWAY=cashfree

# Cashfree settings
CASHFREE_MODE=sandbox   # "sandbox" or "production"
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_SANDBOX_APP_ID=
CASHFREE_SANDBOX_SECRET_KEY=
CASHFREE_PRODUCTION_APP_ID=
CASHFREE_PRODUCTION_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# Razorpay settings
# RAZORPAY_MODE controls which key pair is selected ("sandbox" or "production")
RAZORPAY_MODE=sandbox
# Sandbox (test) credentials — rzp_test_* keys
RAZORPAY_SANDBOX_KEY_ID=
RAZORPAY_SANDBOX_KEY_SECRET=
# Production credentials — rzp_live_* keys (set ONLY in production environment)
RAZORPAY_PRODUCTION_KEY_ID=
RAZORPAY_PRODUCTION_KEY_SECRET=
# Webhook secret — must match the secret configured in the Razorpay dashboard
# Webhook endpoint: https://payxpress-solutions.com/api/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_SERVERNAME=
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM=PayXpress Solutions <noreply@payxpress-solutions.com>

# OTP
OTP_EXPIRY_MINUTES=10

# JWT
JWT_ACCESS_SECRET=
JWT_ACTION_SECRET=
JWT_ACCESS_EXPIRY=7d
