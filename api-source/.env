# ==============================
# SMTP / EMAIL CONFIG
# ==============================
SMTP_HOST=mail.payxpress-solutions.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=noreply@payxpress-solutions.com
SMTP_PASS=Ayan1234

# TLS settings
SMTP_TLS_SERVERNAME=payxpress-solutions.com
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Sender identity
MAIL_FROM=PayXpress Solutions <noreply@payxpress-solutions.com>


# ==============================
# BOUNCE TRACKING (IMAP)
# ==============================
# Enables checking for failed email delivery (bounces)
BOUNCE_TRACKING_ENABLED=true

BOUNCE_IMAP_HOST=mail.payxpress-solutions.com
BOUNCE_IMAP_PORT=993
BOUNCE_IMAP_SECURE=true

BOUNCE_IMAP_USER=noreply@payxpress-solutions.com
BOUNCE_IMAP_PASS=Ayan1234

BOUNCE_IMAP_MAILBOX=INBOX

# Poll interval (seconds)
BOUNCE_POLL_INTERVAL_SECONDS=120

# Mark emails as read after processing
BOUNCE_MARK_SEEN=true


# ==============================
# OTP SETTINGS
# ==============================
OTP_EXPIRY_MINUTES=10