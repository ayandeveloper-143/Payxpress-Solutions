VITE_API_BASE_URL=https://payxpress-solutions.com/api

# Payment gateway: "cashfree" or "razorpay"
VITE_PAYMENT_GATEWAY=cashfree

# Cashfree mode: "sandbox" or "production"
VITE_CASHFREE_MODE=sandbox

# Razorpay mode: "sandbox" or "production"
# (The Razorpay JS SDK key is provided by the backend; this controls the mode label only)
VITE_RAZORPAY_MODE=sandbox

# Set to "false" to disable the checkout button without hiding it
VITE_PAYMENT_GATEWAY_ENABLED=true
